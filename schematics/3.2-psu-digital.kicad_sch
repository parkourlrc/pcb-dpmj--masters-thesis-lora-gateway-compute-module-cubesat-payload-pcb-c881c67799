	)
	(text_box "The TPS62912 PG pin is in high Z when V(FB) >= 95%, and driven low when V(FB) <= 90% . The open-drain pin requires a pullup. The PG signal is used for sequencing of multiple rails by connecting to the EN pin of other converters.\n\nTo ensure control of all digital IOs during the power-up/down of the SX1302 and avoid an inrush current, the 1.2 V rail shall be enabled before 3.3 V at start-up."
		(exclude_from_sim no)
		(at 15.24 177.8 0)
		(size 63.5 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
