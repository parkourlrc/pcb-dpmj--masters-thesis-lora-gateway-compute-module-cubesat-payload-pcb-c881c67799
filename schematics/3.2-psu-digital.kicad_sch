	(text_box "S-CONF to 42.2 kOhm resistor:\n- F_{SW} = 2.2 MHz\n- Spread spectrum random\n- Output discharge ON\n- Sync OFF"
		(exclude_from_sim no)
		(at 45.72 78.74 0)
